{
  "name": "onestop-analytics",
  "version": "1.0.0",
  "description": "OneStop Analytics Orchestration",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "etl":      "cd ETL-backend      && venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8111 --reload",
    "dw":       "cd dw-backend       && venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8004 --reload",
    "analytics":"cd Analytics-backend && venv\\Scripts\\python.exe -m uvicorn main:app      --host 127.0.0.1 --port 8010 --reload",

    "start": "concurrently --kill-others-on-fail --names \"FRONTEND,ETL,DW,ANALYTICS\" --prefix-colors \"cyan,yellow,green,magenta\" \"npm run frontend\" \"npm run etl\" \"npm run dw\" \"npm run analytics\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

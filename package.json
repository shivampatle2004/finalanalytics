{
  "name": "onestop-analytics",
  "version": "1.0.0",
  "description": "OneStop Analytics Orchestration",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "etl": "cd ETL-backend && venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "dw": "cd dw-backend && venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8004",
    "analytics": "cd Analytics-backend && venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8010",

    "start": "concurrently \"npm run frontend\" \"npm run etl\" \"npm run dw\" \"npm run analytics\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
